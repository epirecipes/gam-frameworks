has_cens <- any(event == 0L)
## censor-point vector: censored obs → point = x[i]; exact → x[i] + 1
censor_point <- if (has_cens) ifelse(event == 0L, x, x + 1) else NULL
y_obs        <- x
dat          <- data.frame(y = round(y_obs))
## ---- 2. helper that fits one family --------------------------------------
fit_one <- function(fam_name) {
## 2a. fetch the *function* object from gamlss.dist namespace
base_fun <- getExportedValue("gamlss.dist", fam_name)
## 2b. build censored version if needed
fam_for_fit <- if (has_cens) {
suppressMessages(
gamlss.cens::gen.cens(family = base_fun,
type   = "right",
point  = censor_point)
)                       # returns e.g. "NBIrc" (character string)
} else fam_name           # just the original name
## 2c. run the fit
tryCatch(
gamlss::gamlss(
formula = y ~ 1,
family  = fam_for_fit,              # character string is fine
data    = dat,
control = gamlss::gamlss.control(n.cyc = max_cyc, trace = FALSE)
),
error = function(e) e
)
}
## ---- 3. fit all families --------------------------------------------------
fits <- lapply(families, fit_one)
names(fits) <- families
class(fits) <- c("gamlss_list", class(fits))
fits
}
mers_survival <- fit_int_gamlss(x=mers$duration, event=mers$cens)
#' Fit several integer-valued GAMLSS models
#' (optionally with arbitrary right-censoring via 0/1 event codes)
#'
#' @param x        numeric or integer vector of observations
#' @param event    0/1 vector (1 = exact, 0 = right-censored at x[i]);
#'                 if NULL, no censoring
#' @param families character vector of GAMLSS family names
#' @param max_cyc  maximum IRLS iterations
#'
#' @return named list of fitted "gamlss" objects (errors for failed fits)
fit_int_gamlss <- function(x,
event     = NULL,
families  = c("PO", "NBI", "NBII",
"ZIP", "ZINBI", "DEL", "SI"),
max_cyc   = 100)
{
## ---- 0. required packages -------------------------------------------------
if (!requireNamespace("gamlss",      quietly = TRUE))
stop("Package 'gamlss' is required but not installed.")
if (!requireNamespace("gamlss.dist", quietly = TRUE))
stop("Package 'gamlss.dist' is required but not installed.")
cens_requested <- !is.null(event) && any(event == 0, na.rm = TRUE)
if (cens_requested && !requireNamespace("gamlss.cens", quietly = TRUE))
stop("Right-censoring requested, but package 'gamlss.cens' is not installed.")
## ---- 1. prepare data and censor-point vector -----------------------------
x <- as.numeric(x)
n <- length(x)
if (is.null(event)) event <- rep(1L, n)
if (length(event) != n)           stop("'event' must match 'x' length")
if (!all(event %in% c(0, 1, NA))) stop("'event' must contain only 0, 1 or NA")
event[is.na(event)] <- 0L
event <- as.integer(event)
has_cens <- any(event == 0L)
## censor-point vector: censored obs → point = x[i]; exact → x[i] + 1
censor_point <- if (has_cens) ifelse(event == 0L, x, x + 1) else NULL
y_obs        <- x
dat          <- data.frame(y = round(y_obs))
## ---- 2. helper that fits one family --------------------------------------
fit_one <- function(fam_name) {
## 2a. fetch the *function* object from gamlss.dist namespace
base_fun <- getExportedValue("gamlss.dist", fam_name)
## 2b. build censored version if needed
fam_for_fit <- if (has_cens) {
suppressMessages(
gamlss.cens::gen.cens(family = base_fun,
type   = "right",
point  = censor_point)
)                       # returns e.g. "NBIrc" (character string)
} else fam_name           # just the original name
## 2c. run the fit
tryCatch(
gamlss::gamlss(
formula = y ~ 1,
family  = fam_for_fit,              # character string is fine
data    = dat,
control = gamlss::gamlss.control(n.cyc = max_cyc, trace = FALSE)
),
error = function(e) e
)
}
## ---- 3. fit all families --------------------------------------------------
fits <- lapply(families, fit_one)
names(fits) <- families
class(fits) <- c("gamlss_list", class(fits))
fits
}
mers_survival <- fit_int_gamlss(x=mers$duration, event=mers$cens)
