# function reads in csv of daily environmental covariate values and generates lagged covariate data
#' @param loc file location where csvs of daily environmental covariates are stored
#' @param dates vector of focal dates for calculating lags
generateLaggedCovariates = function(loc, dates){
#  ---------- read files and initial housekeeping -------------
file_loc = list.files(loc, pattern=".csv", full.names=TRUE)
file_loc = file_loc[ grep(adminLevel, file_loc) ]
cc = do.call(rbind.data.frame, lapply(file_loc, read.csv)) %>%
dplyr::mutate(date = as.Date(date))
# remove extraneous time flags
cc = cc[ , -which(names(cc) %in% c("year", "month", "day"))]
# simplify variable names
if(grepl("landsurfacetemp", cc$variable[1])){ cc$variable = "temperature" }
if(grepl("precip", cc$variable[1])){ cc$variable = "precip" }
if(grepl("EVI", cc$variable[1])){ cc$variable = "evi" }
if(grepl("spi1", cc$variable[1])){ cc$variable = "spi1" }
if(grepl("spi3", cc$variable[1])){ cc$variable = "spi3" }
if(grepl("spi6", cc$variable[1])){ cc$variable = "spi6" }
if(grepl("spi12", cc$variable[1])){ cc$variable = "spi12" }
# ----------- generate X day averages of windowLength as specified --------------
# apply rolling mean of windowLength
cc = cc %>%
dplyr::arrange(adminCode, date) %>%
dplyr::group_by(adminCode) %>%
dplyr::mutate(value = data.table::frollmean(value, n=windowLength, align="right", na.rm=TRUE)) %>%
dplyr::ungroup() %>%
dplyr::mutate(value2 = value)
# name value at lag 0
names(cc)[ncol(cc)] = paste(cc$variable[1], "0", sep="_")
# ----------- replace any missing values in time series with nearest available date ----------
# find any missing date data during study period (arising from missing source data)
date_range = seq.Date(min(cc$date), max(cc$date), by=1)
missing_dates = date_range[ which(!date_range %in% cc$date) ]
# replace missing dates with the nearest measurement date (usually one day before/after)
if(length(missing_dates) > 0){
print(paste("Fixing", length(missing_dates), "missing environmental data points", sep=" "))
ud = unique(cc$date)
md = data.frame(md = missing_dates,
date=as.Date(sapply(missing_dates, FUN = function(x){ ud[ which.min(abs(ud - x)) ][1] }), origin="1970-01-01"))
# Ensure `md` has unique `date` values to avoid many-to-many relationship
md = md[!duplicated(md$date), ]
replacement = cc[ cc$date %in% md$date, ] %>%
dplyr::left_join(md, by="date") %>%
dplyr::mutate(date = md) %>%
dplyr::select(-md) %>%
dplyr::distinct()
cc = rbind(cc, replacement) %>%
dplyr::arrange(adminCode, date)
}
# ----------- generate lags at specified days prior to focal date ----------
# data frame for results containing all dates
result = expand.grid(unique(cc$adminCode), unique(cc$adminLevel), dates) %>%
dplyr::rename("adminCode"=1, "adminLevel"=2, "date"=3) %>%
dplyr::mutate(variable = cc$variable[1]) %>%
dplyr::left_join(
select(cc, -value)
)
# for each lag, add lag days and left_join
lag_days = c(30, 60, 90, 120, 150, 180)
for(lag in lag_days){
cc_l <- cc %>%
dplyr::mutate(date = date + lag) %>%
dplyr::select(adminCode, date, value) %>%
dplyr::distinct(adminCode, date, .keep_all = TRUE)
result = left_join(result, cc_l, by=c("adminCode", "date"))
names(result)[ncol(result)] = paste(result$variable[1], lag, sep="_")
}
# ---------- save and return -----------
result = result %>% dplyr::select(-variable)
return(result)
}
# general dependencies
library(data.table); library(tidyr); library(dplyr); library(reticulate); library(sf); library(ggplot2); library(magrittr); library(purrr)
library(lubridate); library(spdep); library(Hmisc); library(sn)
setwd("~/Projects/github3/lassa_sentinel")
# inla
library(INLA)
library(glue)
library(mem)
library(ggtext)
if(!exists("caseDef")){
caseDef = "confirmed"
}
if(!exists("adminLevel")){
adminLevel = "admin1"
}
if(!exists("windowLength")){
windowLength = 60
}
# each time forecast model is run generates a save directory with timestamp (date_time)
timestamp = format(Sys.time(), "%Y%m%d_%H%M")
# save directory for forecast output
output_folder = "./output/forecast_weekly/"
save_dir = paste(output_folder, adminLevel, "_", timestamp, "/", sep="")
if(!dir.exists(save_dir)){
dir.create(save_dir)
}
# dataframe build using variables specified; creates dataframe "dd"
print("Building temporal prediction model dataframe")
source("./scripts/02_forecast_weekly/03_build_modeldf_temporal.R", local = TRUE)
dd <- dd %>%
as_tibble()
# Defining a threshold to be "now" for illustrative purposes, so that modelling after this point
# can be interpreted as a projection. We choose the start of December 2024 so that the 2025 epidemic peak
# is included in the forecast period.
THRESHOLD <- ymd('2024-12-01')
dd <- dd %>%
mutate(cases = ifelse(date > THRESHOLD, NA, cases))
# Surveillance has improved over the years; the corollary to this is that case data from long ago
# is less useful for modelling purposes. We choose an arbitrary date to begin modelling from.
MODELLING_START <- ymd('2016-01-01')
# Load shapefile
if(adminLevel == "admin1"){
shp = sf::st_read("./output/lassa_processed/nigeria_admin1_shapefile.shp") %>%
dplyr::mutate(polyid = 1:length(adminCode))
}
if(adminLevel == "admin2"){
shp = sf::st_read("./output/lassa_processed/nigeria_admin2_shapefile.shp") %>%
dplyr::mutate(polyid = 1:length(adminCode))
}
# neighbourhood adjacency matrix for spatial component of model
# creates field "polyid" that links dataframe to nb matrix
idx = data.frame(adminCode = shp$adminCode, polyid = 1:nrow(shp))
nb = spdep::poly2nb(as_Spatial(shp), row.names=idx$polyid)
nb_loc = paste(save_dir, "nbmatrix", sep="")
spdep::nb2INLA(nb_loc, nb)
dd = left_join(dd, idx)
# load INLA model functions and default priors
source("./scripts/02_forecast_weekly/00_inla_funcs.R", local = TRUE)
admin_subset <- shp %>%
dplyr::select(adminCode, adminName) %>%
st_drop_geometry() %>%
dplyr::filter(adminName %in% c("Edo", "Ondo", "Ebonyi",  "Plateau", "Bauchi", "Taraba", "Kogi", "Benue")) %>%
dplyr::mutate(region = c(rep("south", 3), rep("north", 5)))
dd = dd %>%
dplyr::left_join(admin_subset) %>%
dplyr::filter(!is.na(region))
# 1. precip_150 (bin in 0.25 intervals)
p_bins = c(seq(0, 12, by=0.25))
dd$precip = p_bins[ .bincode(dd$precip_150, breaks=p_bins) ]
dd$precip[ dd$precip_150 > 12 ] = 12.25
# 2. spi6_120 (bin in 0.1 intervals)
spi_bins = seq(-3, 2, by=0.1)
dd$spi = spi_bins[ .bincode(dd$spi6_120, breaks=spi_bins) ]
dd$spi[ dd$spi6_120 > 2 ] = 2.1
dd$spi[ dd$spi6_120 < -3 ] = -3.1
# exclude rows with incomplete covariate data
any_nas = which( apply(dd[, c("spi", "precip")], 1, function(x) any(is.na(x))) )
dd = dd[ -any_nas,  ]
# Apply the modelling start filter described above and remove data that is further into the future
# than the minimum of the two covariate lags defined above (i.e. 120 days)
dd <- dd %>%
filter(date >= MODELLING_START,
date <= THRESHOLD + days(120))
# response variables and factor codes
dd = dd %>%
dplyr::mutate(
y = cases,
polyid2 = polyid,
region2 = as.integer(as.factor(region)),
epiWeek = replace(epiWeek, epiWeek == 53, 52) # only affects 2015 but hacky - need to fix this properly
)
print("Running model and predicting")
# model formula
form = formula(y ~ 1 +
offset(logpop) +
f(polyid, model="bym2", graph=nb_loc, scale.model=TRUE, constr=TRUE, adjust.for.con.comp=TRUE, hyper=hyper.bym2) +
f(year, model="rw1", replicate=polyid2, scale.model=TRUE, constr=TRUE, hyper=hyper3.rw) +
f(epiWeek, model="rw2", cyclic=TRUE, replicate=region2, scale.model=TRUE, constr=TRUE, hyper=hyper3.rw) +
f(spi, model="rw2", scale.model=TRUE, constr=TRUE, hyper=hyper2.rw) +
f(precip, model="rw2", scale.model=TRUE, constr=TRUE, hyper=hyper2.rw))
numThreads <- 7
# run model
mod1 = fitINLAModel(formx = form,
data = dd,
family = "zeroinflatednbinomial0",
config = TRUE, # for sample extraction
num.threads = numThreads)
mod1
dd
View(dd)
df
dd2
write_tsv(dd, "lassa_states_endemic.tsv")
