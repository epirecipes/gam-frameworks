library(INLA)
library(ggplot2)
set.seed(123)  # for reproducibility
setwd("~/Projects/github3/inla_hurdle")
df <- read.table("./lassa_states_endemic.tsv", header=TRUE, row.names=NULL)
# Exclude missing (forecast) datapoints
df <- df[!is.na(df$y),]
nb_loc <- "./states_nbmatrix"
vars <- c("y","logpop","polyid","polyid2","region", "region2","year","epiWeek","spi","precip")
df2 <- df[,vars]
# fixed effects priors
control.fixed1 = list(mean.intercept=0, # prior mean for intercept
prec.intercept=0.01, # prior precision for intercept
mean=0, # prior mean for fixed effects
prec=1)  # prior precision for (scaled) fixed effects
# hyperpriors for iid, ar1, bym2
hyper.iid = list(theta = list(prior="pc.prec", param=c(1, 0.01)))
# for bym or bym2
hyper.bym = list(theta1 = list(prior="pc.prec", param=c(1, 0.01)),
theta2 = list(prior="pc.prec", param=c(1, 0.01)))
hyper.bym2 = list(theta1 = list(prior="pc.prec", param=c(1, 0.01)),
theta2 = list(prior="pc", param=c(0.5, 0.5)))
# ar1
hyper.ar1 = list(theta1 = list(prior='pc.prec', param=c(1, 0.01)),
rho = list(prior='pc.cor0', param = c(0.75, 0.5)))
# random walk hyperparameters on smoothing
hyper1.rw = list(prec = list(prior='pc.prec', param=c(0.1, 0.01))) # strictest; sd constrained to be low
hyper2.rw = list(prec = list(prior='pc.prec', param=c(0.5, 0.01))) # medium
hyper3.rw = list(prec = list(prior='pc.prec', param=c(1, 0.01))) # weakest; sd can be quite wide
n <- nrow(df2)
is_positive <- df2$y > 0
y_bin <- as.integer(is_positive)
y_cnt <- df2$y
y_cnt[!is_positive] <- NA
# Create component-specific covariate copies
effects_bin <- data.frame(
intercept_bin = rep(1, n),
intercept_cnt = rep(0, n),
spi_bin = df2$spi,
spi_cnt = rep(0, n),
precip_bin = df2$precip,
precip_cnt = rep(0, n),
logpop_offset = rep(0, n),
polyid_bin = df2$polyid,
polyid_cnt = factor(rep(NA, n), levels = levels(df2$polyid)),
polyid2_bin = df2$polyid2,
polyid2_cnt = factor(rep(NA, n), levels = levels(df2$polyid2)),
region2_bin = df2$region2,
region2_cnt = factor(rep(NA, n), levels = levels(df2$region2)),
year_bin = df2$year,
year_cnt = rep(NA, n),
epiWeek_bin = df2$epiWeek,
epiWeek_cnt = rep(NA, n)
)
effects_cnt <- data.frame(
intercept_bin = rep(0, n),
intercept_cnt = rep(1, n),
spi_bin = rep(0, n),
spi_cnt = df2$spi,
precip_bin = rep(0, n),
precip_cnt = df2$precip,
logpop_offset = df2$logpop,
polyid_bin = factor(rep(NA, n), levels = levels(df2$polyid)),
polyid_cnt = df2$polyid,
polyid2_bin = factor(rep(NA, n), levels = levels(df2$polyid2)),
polyid2_cnt = df2$polyid2,
region2_bin = factor(rep(NA, n), levels = levels(df2$region2)),
region2_cnt = df2$region2,
year_bin = rep(NA, n),
year_cnt = df2$year,
epiWeek_bin = rep(NA, n),
epiWeek_cnt = df2$epiWeek
)
stack_bin <- inla.stack(
data = list(y = y_bin, Ntrials = rep(1, n)),
A = list(1),
effects = list(effects_bin),
tag = "bin"
)
stack_cnt <- inla.stack(
data = list(y = y_cnt),
A = list(1),
effects = list(effects_cnt),
tag = "cnt"
)
stk <- inla.stack(stack_bin, stack_cnt)
stack_bin
stack_cnt
