df <- read.table("../data/lassa_states_endemic.tsv", header=TRUE, row.names=NULL)
# Exclude missing (forecast) datapoints
df <- df[!is.na(df$y),]
nb_loc <- "../data/states_nbmatrix"
vars <- c("y","logpop","polyid","polyid2","region", "region2","year","epiWeek","spi","precip")
df2 <- df[,vars]
n_obs <- nrow(df2)
## Binary component for the zero hurdle (1 indicates a positive count)
y_indicator <- as.integer(df2$y > 0)
## Count component (positive counts only) – use NA to drop zero outcomes
y_positive <- df2$y
y_positive[y_positive == 0] <- NA
## Build component-specific intercepts so both likelihoods can have their own.
intercept_zero <- rep(1, n_obs)
intercept_count <- rep(1, n_obs)
## Construct stacks for the binomial and truncated negative binomial components
stack_zero <- inla.stack(
data = list(
y = y_indicator,
Ntrials = rep(1, n_obs),
E = rep(NA, n_obs)
),
A = list(1),
effects = list(
data.frame(
intercept_zero = intercept_zero,
intercept_count = rep(0, n_obs),
polyid = df2$polyid,
polyid2 = df2$polyid2,
region2 = df2$region2,
year = df2$year,
epiWeek = df2$epiWeek,
spi = df2$spi,
precip = df2$precip
)
),
tag = "zero"
)
stack_count <- inla.stack(
data = list(
y = y_positive,
Ntrials = rep(NA, n_obs),
E = exp(df2$logpop)
),
A = list(1),
effects = list(
data.frame(
intercept_zero = rep(0, n_obs),
intercept_count = intercept_count,
polyid = df2$polyid,
polyid2 = df2$polyid2,
region2 = df2$region2,
year = df2$year,
epiWeek = df2$epiWeek,
spi = df2$spi,
precip = df2$precip
)
),
tag = "count"
)
stack_hurdle <- inla.stack(stack_zero, stack_count)
stack_data <- inla.stack.data(stack_hurdle)
stack_A <- inla.stack.A(stack_hurdle)
## Restructure the response and binomial trials into separate likelihood slots.
response_bin <- stack_data$y
response_count <- stack_data$y
response_bin[(n_obs + 1):(2 * n_obs)] <- NA
response_count[1:n_obs] <- NA
stack_data$y <- list(response_bin, response_count)
trials_bin <- stack_data$Ntrials
trials_count <- stack_data$Ntrials
trials_bin[(n_obs + 1):(2 * n_obs)] <- NA
trials_count[1:n_obs] <- NA
stack_data$Ntrials <- list(trials_bin, trials_count)
exposure_bin <- stack_data$E
exposure_count <- stack_data$E
exposure_bin[(n_obs + 1):(2 * n_obs)] <- NA
exposure_count[1:n_obs] <- NA
stack_data$E <- list(exposure_bin, exposure_count)
# fixed effects priors
control.fixed1 = list(mean.intercept=0, # prior mean for intercept
prec.intercept=0.01, # prior precision for intercept
mean=0, # prior mean for fixed effects
prec=1)  # prior precision for (scaled) fixed effects
# hyperpriors for iid, ar1, bym2
hyper.iid = list(theta = list(prior="pc.prec", param=c(1, 0.01)))
# for bym or bym2
hyper.bym = list(theta1 = list(prior="pc.prec", param=c(1, 0.01)),
theta2 = list(prior="pc.prec", param=c(1, 0.01)))
hyper.bym2 = list(theta1 = list(prior="pc.prec", param=c(1, 0.01)),
theta2 = list(prior="pc", param=c(0.5, 0.5)))
# ar1
hyper.ar1 = list(theta1 = list(prior='pc.prec', param=c(1, 0.01)),
rho = list(prior='pc.cor0', param = c(0.75, 0.5)))
# random walk hyperparameters on smoothing
hyper1.rw = list(prec = list(prior='pc.prec', param=c(0.1, 0.01))) # strictest; sd constrained to be low
hyper2.rw = list(prec = list(prior='pc.prec', param=c(0.5, 0.01))) # medium
hyper3.rw = list(prec = list(prior='pc.prec', param=c(1, 0.01))) # weakest; sd can be quite wide
form <-  y ~ -1 +
intercept_zero + intercept_count +
f(polyid, model = "bym2", graph = nb_loc, scale.model = TRUE, constr = TRUE,
adjust.for.con.comp = TRUE, hyper = hyper.bym2) +
f(year, model = "rw1", replicate = polyid2, scale.model = TRUE, constr = TRUE,
hyper = hyper3.rw) +
f(epiWeek, model = "rw2", cyclic = TRUE, replicate = region2, scale.model = TRUE,
constr = TRUE, hyper = hyper3.rw) +
f(spi, model = "rw2", scale.model = TRUE, constr = TRUE, hyper = hyper2.rw) +
f(precip, model = "rw2", scale.model = TRUE, constr = TRUE, hyper = hyper2.rw)
fit <- inla(
form_hurdle,
verbose = FALSE,
data = stack_data,
family = c("binomial", "zeroinflatednbinomial0"),
Ntrials = stack_data$Ntrials,
control.family = list(
list(link = "logit"),
list(
link = "log",
hyper = list(
prob = list(initial = -20, fixed = TRUE)
)
)
),
control.fixed = control.fixed1,
control.predictor = list(
compute = TRUE,
A = stack_A,
link = rep(1, nrow(stack_A))
),
control.compute = list(
cpo = TRUE,
waic = TRUE,
dic = TRUE,
config = TRUE,
return.marginals = TRUE
),
control.inla = list(
strategy = 'adaptive',
cmin = 0
),
inla.mode = "experimental"
)
fit <- inla(
form,
verbose = FALSE,
data = stack_data,
family = c("binomial", "zeroinflatednbinomial0"),
Ntrials = stack_data$Ntrials,
control.family = list(
list(link = "logit"),
list(
link = "log",
hyper = list(
prob = list(initial = -20, fixed = TRUE)
)
)
),
control.fixed = control.fixed1,
control.predictor = list(
compute = TRUE,
A = stack_A,
link = rep(1, nrow(stack_A))
),
control.compute = list(
cpo = TRUE,
waic = TRUE,
dic = TRUE,
config = TRUE,
return.marginals = TRUE
),
control.inla = list(
strategy = 'adaptive',
cmin = 0
),
inla.mode = "experimental"
)
summary(fit)
plot(fit)
