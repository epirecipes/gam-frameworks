form_gam <- formula(y ~ 1 +
offset(logpop) +
# Spatial effect – using a Markov random field smoother:
s(polyid, bs = "mrf", xt = list(nb = nb2)) +
# RW1 on year with one smooth per level of polyid2:
s(year, bs = "ps", m = 1, by = polyid2) +
# RW2 on epiWeek, cyclic, with one smooth per level of region2:
s(epiWeek, bs = "cc", m = 2, by = region2) +
# RW2 on spi:
s(spi, bs = "ps", k=12) +
# RW2 on precip:
s(precip, bs = "ps", k=12))
system.time(mod1gam <- gam(form_gam, data=dd2, family=poisson()))
system.time(mod1 <- fitINLAModel(formx = form, data = dd2, family = "poisson", config = TRUE))
